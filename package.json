{
	"name": "cursor-danang",
	"version": "0.3.1",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit",
		"validate:bento": "tsx scripts/validate-bento.ts",
		"validate:community-tweets": "tsx scripts/validate-community-tweets.ts",
		"test:smoke": "node scripts/smoke-tweets-api.mjs",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:bento && pnpm validate:community-tweets && pnpm build"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.2",
		"@vercel/analytics": "~1.6.1",
		"dompurify": "~3.2.6",
		"framer-motion": "~12.34.2",
		"lucide-react": "~0.575.0",
		"next": "~16.2.6",
		"react": "~19.2.4",
		"react-dom": "~19.2.4",
		"react-tweet": "~3.3.1",
		"simple-icons": "~16.9.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "~4.2.0",
		"@types/dompurify": "~3.0.5",
		"@types/node": "~25.3.0",
		"@types/react": "~19.2.14",
		"@types/react-dom": "~19.2.3",
		"oxfmt": "~0.34.0",
		"oxlint": "~1.49.0",
		"postcss": "~8.5.10",
		"tailwindcss": "~4.2.0",
		"tsx": "~4.21.0",
		"typescript": "~5.9.3",
		"wrangler": "^4.118.0"
	},
	"packageManager": "pnpm@10.8.0"
}
